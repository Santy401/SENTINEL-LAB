{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Santy401/SENTINEL-LAB/main/packages/protocol/schemas/connection.goodbye.schema.json",
  "title": "Connection goodbye payload",
  "description": "Ordered connection teardown with an explicit reason.",
  "type": "object",
  "additionalProperties": false,
  "required": ["reason"],
  "properties": {
    "reason": {
      "type": "string",
      "enum": ["shutdown", "reconnect", "timeout", "client-request"]
    }
  }
}
