{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Santy401/SENTINEL-LAB/main/packages/protocol/schemas/error.schema.json",
  "title": "Protocol error payload",
  "description": "Machine-readable error. Details must never contain secrets. Error correlation must include the source of the rejected message when a sequence is referenced.",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message", "retryable"],
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "INVALID_ENVELOPE",
        "UNSUPPORTED_PROTOCOL_VERSION",
        "UNKNOWN_MESSAGE_TYPE",
        "PAYLOAD_TOO_LARGE",
        "RATE_LIMITED",
        "UNAUTHORIZED",
        "INTERNAL_ERROR"
      ]
    },
    "message": { "type": "string", "minLength": 1, "maxLength": 256 },
    "retryable": { "type": "boolean" },
    "relatedSource": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,63}$"
    },
    "relatedSequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  }
}
