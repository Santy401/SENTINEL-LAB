{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel-lab.local/schemas/1.0.0/error.schema.json",
  "title": "Protocol error payload",
  "description": "Machine-readable error. Details must never contain secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message", "retryable"],
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "INVALID_ENVELOPE",
        "UNSUPPORTED_PROTOCOL_VERSION",
        "UNKNOWN_MESSAGE_TYPE",
        "PAYLOAD_TOO_LARGE",
        "RATE_LIMITED",
        "UNAUTHORIZED",
        "INTERNAL_ERROR"
      ]
    },
    "message": { "type": "string", "minLength": 1, "maxLength": 256 },
    "retryable": { "type": "boolean" },
    "relatedSequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  }
}
