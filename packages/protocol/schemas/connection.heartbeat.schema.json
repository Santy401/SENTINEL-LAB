{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel-lab.local/schemas/1.0.0/connection.heartbeat.schema.json",
  "title": "Connection heartbeat payload",
  "description": "Liveness signal independent of the transport in use.",
  "type": "object",
  "additionalProperties": false,
  "required": ["bootId", "uptimeMs"],
  "properties": {
    "bootId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "uptimeMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  }
}
