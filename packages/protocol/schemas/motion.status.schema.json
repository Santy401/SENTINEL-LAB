{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Santy401/SENTINEL-LAB/main/packages/protocol/schemas/motion.status.schema.json",
  "title": "Motion ingest status payload",
  "description": "Summary of the native motion ingest state exposed by /api/motion/status.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deviceId",
    "sourceType",
    "paired",
    "acceptedSamples",
    "lastSampleAgeMs",
    "signalLost",
    "simulationRejected",
    "simulated"
  ],
  "properties": {
    "deviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "sourceType": {
      "type": "string",
      "enum": ["None", "BrowserDeviceMotion", "NativeClient"]
    },
    "paired": { "type": "boolean" },
    "acceptedSamples": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "lastSampleAgeMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "lastHttpCode": { "type": "integer", "minimum": 100, "maximum": 599 },
    "signalLost": { "type": "boolean" },
    "simulationRejected": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "simulated": { "const": false }
  }
}
