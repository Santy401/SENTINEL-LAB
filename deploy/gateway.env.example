# Copy to ~/.config/sentinel-lab/gateway.env (chmod 600). No secrets here:
# token and HMAC secret are paths to owner-only files.
SENTINEL_REPO=%h/Github/sentinel-firmware
SENTINEL_DEVICE=192.168.4.1
SENTINEL_BIND=127.0.0.1
SENTINEL_PORT=8080
SENTINEL_TOKEN_FILE=%h/.config/sentinel-lab/realtime-token
SENTINEL_DB=%h/.local/share/sentinel-lab/history.db
# Alerts to n8n (store-and-forward, HMAC-signed). Leave empty to keep alerts local.
SENTINEL_ALERT_ARGS=--alert-webhook-url https://n8n.nexuscloud.sbs/webhook/sentinel-alerts --alert-secret-file %h/.config/sentinel-lab/alert-secret
# Dry run instead (prints alerts in the journal):
# SENTINEL_ALERT_ARGS=--alert-dry-run
